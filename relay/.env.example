# Copy to relay/.env, or run npm run setup. Never commit .env.
PORT=8787
HOST=127.0.0.1
# At least 32 random characters; npm run setup generates this.
RELAY_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# Browser origin only: no repository path, no trailing slash.
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io,http://localhost:8787,http://127.0.0.1:8787
FFMPEG_PATH=ffmpeg
# If your FFmpeg build cannot find OS certificates, set a trusted CA bundle.
# TLS_CA_FILE=C:/path/to/trusted-ca-bundle.pem
# Optional font file. Automatic font discovery works on Windows/macOS/Linux.
# FONT_FILE=C:/Windows/Fonts/arial.ttf

# YouTube website sign-in. Configure a Google Web application OAuth client.
# Register this exact callback on the website; see docs/YOUTUBE.md.
# Client secret stays here, never in the public web/ folder.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Manual destination fallback / Facebook and Instagram Live Producer keys.
# A connected YouTube account requires its own setup and suppresses this fallback.
# Leave unused destinations empty. Only RTMPS is accepted.
YOUTUBE_SERVER=
YOUTUBE_KEY=
FACEBOOK_SERVER=
FACEBOOK_KEY=
INSTAGRAM_SERVER=
INSTAGRAM_KEY=
# 720 = compatibility portrait (720x1280); 1080 = 1080x1920 if accepted.
INSTAGRAM_HEIGHT=1280
# Browser uploads 8 Mbps balanced or 14 Mbps detail. Relay uses 6 Mbps if
# Facebook is selected, otherwise up to 10 Mbps. Instagram defaults to 3.5 Mbps.
LANDSCAPE_VIDEO_KBPS=10000
INSTAGRAM_VIDEO_KBPS=3500
ENCODER_PRESET=veryfast

# Default is a read-only CricClubs overlay endpoint. Club feed access may be
# restricted or change; obtain permission from your league/CricClubs.
SCORE_POLL_SECONDS=5
# Instant replay stays in bounded laptop RAM. No camera footage is saved to disk.
REPLAY_BUFFER_SECONDS=30
REPLAY_MEMORY_MB=192
# Time from a delivery to its score update. Calibrate for your scorer/network.
SCORER_DELAY_SECONDS=6
# Optional: approved feed that returns the canonical JSON in docs/CRICCLUBS.md.
# Template placeholders are {clubId} and {matchId}. HTTPS only. Server-side only.
# SCORE_URL_TEMPLATE=https://YOUR_APPROVED_FEED/score?clubId={clubId}&matchId={matchId}
# SCORE_HEADER_NAME=Authorization
# SCORE_HEADER_VALUE=Bearer YOUR_APPROVED_API_TOKEN
