{
  "name": "boundary-live",
  "version": "1.1.0",
  "private": true,
  "description": "Mobile cricket broadcast studio with a self-hosted streaming relay",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=relay/.env relay/server.mjs",
    "setup": "node relay/setup.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "ws": "8.22.0"
  }
}
