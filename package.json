{
  "name": "mk97-live",
  "version": "1.6.2",
  "private": true,
  "description": "Phone-first cricket broadcast studio with cloud streaming and live scores",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=relay/.env relay/server.mjs",
    "setup": "node relay/setup.mjs",
    "scrape": "node scripts/scrape-cricclubs.mjs",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "cheerio": "1.2.0",
    "robots-parser": "3.0.1",
    "ws": "8.22.0"
  }
}
